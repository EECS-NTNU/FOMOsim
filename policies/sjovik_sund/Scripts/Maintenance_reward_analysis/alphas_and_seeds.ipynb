    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# --- Configuration & Data ---\n",
    "\n",
    "colors = {\n",
    "    \"pale_fern\": \"#D9E5D6\",\n",
    "    \"sage_green\": \"#84A579\",\n",
    "    \"dark_spruce\": \"#344E41\",\n",
    "    \"warm_red\": \"#D1495B\",\n",
    "    \"ochre_gold\": \"#EDAE49\",\n",
    "    \"blue_accent\": \"#526ECA\",\n",
    "    \"mist_grey\": \"#E6E6E6\"\n",
    "}\n",
    "\n",
    "# 1. Base Wage Calculation (5 days)\n",
    "# 8 hours * 2 workers * 250 NOK * 5 days\n",
    "days = 5\n",
    "workers = 2\n",
    "hours_per_day = 8\n",
    "wage_per_hour = 250\n",
    "\n",
    "total_base_wage = days * workers * hours_per_day * wage_per_hour # 20,000 NOK\n",
    "\n",
    "# 2. Dynamic Policy Costs\n",
    "# Maintenance is \"internal\" (part of the base wage)\n",
    "dyn_maint_cost = 6775\n",
    "dyn_base_cost = total_base_wage - dyn_maint_cost \n",
    "\n",
    "# 3. Static Policy Costs\n",
    "# Maintenance is \"external\" (added on top of base wage)\n",
    "static_night_cost = 7613 \n",
    "\n",
    "# --- Plotting ---\n",
    "\n",
    "plt.figure(figsize=(9, 6)) # Slightly wider for better label fit\n",
    "bar_width = 0.5\n",
    "x_pos = [0, 1]\n",
    "labels = ['Dynamic daytime\\nmaintenance', 'Static nightly\\nmaintenance']\n",
    "\n",
    "# --- Bar 1: Dynamic Strategy (Fixed total height: 20,000) ---\n",
    "# Bottom part: Direct Maintenance (Highlighted)\n",
    "p1 = plt.bar(x_pos[0], dyn_maint_cost, width=bar_width, \n",
    "        color=colors[\"sage_green\"], edgecolor=colors[\"blue_accent\"], \n",
    "        hatch='//', label='Dynamic maintenance cost')\n",
    "\n",
    "# Top part: Remaining Base Wage\n",
    "p2 = plt.bar(x_pos[0], dyn_base_cost, width=bar_width, bottom=dyn_maint_cost,\n",
    "        color=colors[\"sage_green\"], label='Base operational wage')\n",
    "\n",
    "\n",
    "# --- Bar 2: Static Strategy (Total height: 27,613) ---\n",
    "# Bottom part: Base Wage (Full day capacity)\n",
    "p3 = plt.bar(x_pos[1], total_base_wage, width=bar_width, \n",
    "        color=colors[\"sage_green\"]) # No label to avoid duplicate legend entry\n",
    "\n",
    "# Top part: Additional Night Cost\n",
    "p4 = plt.bar(x_pos[1], static_night_cost, width=bar_width, bottom=total_base_wage,\n",
    "        color=colors[\"warm_red\"], label='Additional night cost')\n",
    "\n",
    "\n",
    "\n",
    "# --- Formatting ---\n",
    "\n",
    "# Y-Axis\n",
    "max_y = total_base_wage + static_night_cost + 3000\n",
    "plt.ylim(0, max_y)\n",
    "plt.ylabel(\"Total cost (NOK) over 5 days\", fontsize=12)\n",
    "plt.yticks(fontsize=10)\n",
    "\n",
    "# X-Axis\n",
    "plt.xticks(x_pos, labels, fontsize=12)\n",
    "\n",
    "# --- Value Labels ---\n",
    "\n",
    "# 1. Dynamic Bar Labels\n",
    "# Label inside the maintenance box (bottom)\n",
    "plt.text(x_pos[0], dyn_maint_cost/2, f\"{dyn_maint_cost}\", \n",
    "         ha='center', va='center', color='white', fontweight='bold')\n",
    "# Label inside the base wage box (top) - showing the total 20k\n",
    "plt.text(x_pos[0], dyn_maint_cost + dyn_base_cost - 1000, f\"{total_base_wage}\", \n",
    "         ha='center', va='top', color='white', fontweight='bold')\n",
    "\n",
    "# Top Label: Total Cost (ADDED)\n",
    "plt.text(x_pos[0], total_base_wage + 500, f\"Total: {total_base_wage}\", \n",
    "         ha='center', va='bottom', color='black', fontsize=11, fontweight='bold')\n",
    "\n",
    "# 2. Static Bar Labels\n",
