    "    #plt.title(f\"Hourly Stacked Events: {title_label}\", fontsize=16, pad=20)\n",
    "    plt.legend(fontsize=12, loc='upper right')\n",
    "\n",
    "    # Label the TOTAL height on top of the stack\n",
    "    for h, total in zip(hour_labels, total_vals):\n",
