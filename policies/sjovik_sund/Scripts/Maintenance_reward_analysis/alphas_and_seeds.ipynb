    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_TD2_A025_S1_V2_3h.txt\",\n",
    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_TD2_A025_S1_V3_3h.txt\",\n",
    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_TD_A025_S1_V1_3h.txt\",\n",
    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_TD_A025_S1_V2_3h.txt\",\n",
    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_TD_A025_S1_V3_3h.txt\",\n",
    "    r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_OS_A025_S1_V1._3h.txt\",\n",
    "    #r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_OS_A025_S1_V2.txt\",\n",
    "    #r\"C:\\Users\\Minamsj\\FOMOsim\\policies\\sjovik_sund\\simulation_results\\Vehicle tests\\fullweek_OS_A025_S1_V2.txt\",\n",
    "    # Legg til flere filer her...\n",
    "]\n",
    "\n",
    "# Hvis du vil hente ALLE .txt filer i en mappe automatisk, kan du bruke glob:\n",
    "# import glob\n",
    "# paths = glob.glob(r\"C:\\Users\\Minamsj\\FOMOsim\\...\\*.txt\")\n",
    "\n",
    "all_data = get_all_run_times(paths)\n",
    "grand_total_times = []\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(f\"RAPPORT FOR {len(all_data)} FILER\")\n",
