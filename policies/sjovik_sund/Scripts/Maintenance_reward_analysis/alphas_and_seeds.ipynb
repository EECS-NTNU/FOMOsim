    "def get_result_file(kind: str, seed: int, alpha_val: float, ml_val=None) -> Path:\n",
    "    \"\"\"\n",
    "    Finds a file using robust Regex matching.\n",
    "    \"\"\"\n",
    "    # 1. Regex for Seed\n",
    "    # Matches \"seed1\" or \"seed_1\" followed by a non-digit (underscore, dot, etc)\n",
    "    pat_seed = re.compile(rf\"seed_?{seed}\\D\") \n",
    "    \n",
    "    # 2. Regex for Alpha (FIXED)\n",
    "    # This now handles: \"_alpha0.250_\", \"_0.250_\", or \"alpha0.25_\"\n",
    "    # Logic: Optional \"alpha\" or \"_\", followed by the number, optional trailing zeros, then an underscore.\n",
    "    alpha_clean = f\"{alpha_val}\".rstrip('0') # Turns 0.250 -> 0.25\n",
    "    pat_alpha = re.compile(rf\"(?:alpha|_)?{alpha_clean}0*_\")\n",
    "    \n",
    "    # 3. Regex for Kind\n",
    "    pat_kind = re.compile(re.escape(kind))\n",
    "\n",
    "    # 4. Regex for ML\n",
    "    pat_ml = None\n",
    "    if ml_val is not None:\n",
    "        ml_int = int(round(ml_val * 10))\n",
    "        # Matches \"ML03\" or \"ML3\"\n",
    "        pat_ml = re.compile(rf\"ML0?{ml_int}\") \n",
    "\n",
    "    # Search files\n",
    "    all_files = list(results_dir_root.glob(\"*.csv\"))\n",
    "    \n",
    "    matches = []\n",
    "    for f in all_files:\n",
    "        name = f.name\n",
    "        \n",
    "        # Check Seed\n",
    "        if not pat_seed.search(name): continue\n",
    "            \n",
    "        # Check Alpha\n",
    "        if not pat_alpha.search(name): continue\n",
    "            \n",
    "        # Check Kind\n",
    "        if not pat_kind.search(name): continue\n",
    "\n",
    "        # Check ML\n",
    "        if pat_ml:\n",
    "            if not pat_ml.search(name): continue\n",
    "        else:\n",
    "            # If ml_val is None, ensure NO \"ML\" tag exists\n",
    "            if \"_ML\" in name: continue\n",
    "\n",
    "        matches.append(f)\n",
    "\n",
    "    if not matches:\n",
    "        # Debugging: Print exactly what we were looking for if it fails\n",
    "        # print(f\"❌ Missing: Seed={seed}, Alpha={alpha_val}, Kind={kind}\")\n",
    "        return None\n",
    "    \n",
    "    # If duplicates exist (rare), take the first one\n",
    "    return matches[0]\n",
    "\n",
    "def get_available_seeds(alpha_val: float, ml_val=None) -> list[int]:\n",
    "    \"\"\"Scans folder for seeds present for a specific configuration.\"\"\"\n",
    "    \n",
    "    # Same Alpha Regex as above\n",
    "    alpha_clean = f\"{alpha_val}\".rstrip('0')\n",
    "    pat_alpha = re.compile(rf\"(?:alpha|_)?{alpha_clean}0*_\")\n",
    "    \n",
    "    pat_ml = None\n",
    "    if ml_val is not None:\n",
    "        ml_int = int(round(ml_val * 10))\n",
    "        pat_ml = re.compile(rf\"ML0?{ml_int}\")\n",
    "    \n",
    "    all_files = list(results_dir_root.glob(\"*.csv\"))\n",
    "    seeds = set()\n",
    "    \n",
    "    for f in all_files:\n",
    "        name = f.name\n",
    "        \n",
    "        if not pat_alpha.search(name): continue\n",
    "\n",
    "        if pat_ml:\n",
    "            if not pat_ml.search(name): continue\n",
    "        else:\n",
    "            if \"_ML\" in name: continue\n",
    "            \n",
    "        # We only need to find ONE file type per seed to know the seed exists.\n",
    "        # \"hourly\" is usually a safe bet.\n",
    "        if \"hourly\" not in name: continue\n",
    "\n",
    "        # Extract Seed\n",
    "        match = re.search(r\"seed_?(\\d+)\", name)\n",
    "        if match:\n",
    "            seeds.add(int(match.group(1)))\n",
    "                \n",
    "    return sorted(list(seeds))\n",
    "\n",
    "def load_single_run(seed: int, alpha: float, ml=None) -> dict:\n",
    "    \"\"\"Loads all 4 file types for a specific run.\"\"\"\n",
    "    files = {\n",
    "        # Updated mapping based on your notes\n",
    "        \"vehicle\": get_result_file(\"bike_movements\", seed, alpha, ml), \n",
    "        \"hourly\": get_result_file(\"hourly\", seed, alpha, ml),\n",
    "        \"station_hourly\": get_result_file(\"station_hourly\", seed, alpha, ml),\n",
    "        \"trip_requests\": get_result_file(\"trip_requests\", seed, alpha, ml)\n",
    "    }\n",
    "    \n",
    "    # If any file is missing, return None (incomplete run)\n",
    "    if any(f is None for f in files.values()):\n",
    "        return None\n",
    "        \n",
    "    return {k: pd.read_csv(v) for k, v in files.items()}\n",
    "\n",
