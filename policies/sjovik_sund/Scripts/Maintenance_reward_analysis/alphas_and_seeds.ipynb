    "import re\n",
    "import os\n",
    "\n",
    "def parse_file(filepath):\n",
    "    \"\"\"\n",
    "    Parser en enkelt loggfil og returnerer en liste med tider.\n",
    "    Returnerer None hvis filen ikke finnes.\n",
    "    \"\"\"\n",
    "    saved_times = []\n",
    "    current_val = None\n",
    "    \n",
    "    # Regex som finner tall + 's' på slutten av linjen\n",
    "    time_pattern = re.compile(r'\\s(\\d+(?:\\.\\d+)?)s$')\n",
    "\n",
    "    try:\n",
    "        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:\n",
    "            for line in f:\n",
    "                stripped = line.strip()\n",
    "\n",
    "                # 1. Oppdater \"nåværende\" tid hvis vi ser en linje som slutter på 's'\n",
    "                match = time_pattern.search(stripped)\n",
    "                if match:\n",
    "                    current_val = float(match.group(1))\n",
    "\n",
    "                # 2. Sjekk om blokken er ferdig (\"Explored\" eller \"Solution count\")\n",
    "                if stripped.startswith(\"Explored\") and \"seconds\" in stripped:\n",
    "                    if current_val is not None:\n",
    "                        saved_times.append(current_val)\n",
    "                        current_val = None \n",
    "                \n",
    "                elif stripped.startswith(\"Solution count\") and current_val is not None:\n",
    "                     saved_times.append(current_val)\n",
    "                     current_val = None\n",
    "\n",
    "        return saved_times\n",
    "\n",
    "    except FileNotFoundError:\n",
    "        print(f\"⚠️  Error: File not found: {filepath}\")\n",
    "        return None\n",
    "\n",
    "def get_all_run_times(file_paths):\n",
    "    \"\"\"\n",
    "    Tar inn en liste med filstier og returnerer en dictionary:\n",
    "    { \"filnavn\": [liste_med_tider], ... }\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "    \n",
    "    for path in file_paths:\n",
    "        filename = os.path.basename(path) # Henter kun filnavnet for ryddigere print\n",
    "        times = parse_file(path)\n",
    "        \n",
    "        if times is not None:\n",
    "            results[filename] = times\n",
    "            \n",
    "    return results\n",
    "\n",
    "# --- KJØR SCRIPTET ---\n",
    "\n",
    "# Liste med filstier du vil sjekke\n",
    "paths = [\n",
